# Default server configuration
#

limit_req_zone $binary_remote_addr zone=tile_api:10m rate=20r/s;

server {

    server_name worldmap.grasp.deals;

    root /srv/worldmap/html;
    index index.html;

    access_log /var/log/nginx/cors_debug.log cors_debug;

    location = /api/auth/login {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
    
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    
        proxy_buffering off;
        proxy_read_timeout 30s;
    
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    
    location = /api/auth/access {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
    
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 30s;

        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options "nosniff" always;

        add_header Access-Control-Allow-Origin "https://worldmap.grasp.deals" always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Accept, Content-Type, Range" always;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "https://worldmap.grasp.deals" always;
            add_header Access-Control-Allow-Credentials "true" always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Accept, Content-Type, Range" always;
            add_header Access-Control-Max-Age 1728000 always;
            add_header Content-Length 0;
            return 204;
        }
    }
    
    location ^~ /api/restricted-tiles/ {
        limit_req zone=tile_api burst=40 nodelay;
    
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
    
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 30s;
    
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    
        add_header Access-Control-Allow-Origin "https://worldmap.grasp.deals" always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Accept, Content-Type, Range" always;
    
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "https://worldmap.grasp.deals" always;
            add_header Access-Control-Allow-Credentials "true" always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Accept, Content-Type, Range" always;
            add_header Access-Control-Max-Age 1728000 always;
            add_header Content-Length 0;
            return 204;
        }
    }

    location = /api/restricted-tiles-health {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;

        proxy_buffering off;
        proxy_read_timeout 30s;

        add_header Cache-Control "no-store" always;
    }

    location = /api/restricted-markers {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
    
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    
        add_header Access-Control-Allow-Origin "https://worldmap.grasp.deals" always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Accept, Content-Type" always;
    
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "https://worldmap.grasp.deals" always;
            add_header Access-Control-Allow-Credentials "true" always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Accept, Content-Type" always;
            add_header Access-Control-Max-Age 1728000 always;
            add_header Content-Length 0;
            return 204;
        }
    }

    location = /protomaps.pmtiles {
        alias /srv/worldmap/html/protomaps.pmtiles;

        types {
            application/octet-stream pmtiles;
        }

        add_header Accept-Ranges bytes always;
        add_header Access-Control-Allow-Origin "https://worldmap.grasp.deals" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Range, Content-Type" always;
        add_header Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range, Content-Encoding" always;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "https://worldmap.grasp.deals" always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Range, Content-Type" always;
            add_header Access-Control-Max-Age 1728000 always;
            add_header Content-Length 0;
            return 204;
        }
    }

    location ~ /\. {
        deny all;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/worldmap.grasp.deals/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/worldmap.grasp.deals/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}


